# Copia este fichero a .env (dentro de server/) y pega tu clave.
# La clave vive SOLO aqui: nunca en el navegador, que cualquiera puede leerla.
ANTHROPIC_API_KEY=sk-ant-...

# Opcional. Por defecto claude-opus-5.
# Modelos probados: claude-haiku-4-5 (barato), claude-sonnet-5, claude-opus-5
# ANTHROPIC_MODEL=claude-haiku-4-5

# Opcional. Por defecto 8787.
# PORT=8787

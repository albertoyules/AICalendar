# Copia este fichero a .env.local y rellena con los datos de tu proyecto de Firebase
# (Consola de Firebase > Configuracion del proyecto > Tus apps > Configuracion del SDK).
#
# Si dejas esto sin rellenar la app sigue funcionando: guarda todo en el navegador
# (localStorage), asi puedes probarla antes de tener Firebase montado.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Opcional: solo hace falta para los avisos push (fase 4).
# Firebase Console > Configuracion del proyecto > Cloud Messaging >
# Certificados push web > Generar par de claves.
VITE_FIREBASE_VAPID_KEY=
